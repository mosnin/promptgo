# Canonical origin. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://fastprompts.org

# Google Analytics 4. The production property is checked in as the default in
# src/lib/site.ts, so leaving this blank still reports to it. Set it only to
# point a preview or staging deployment at a different property.
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Search engine ownership verification. Paste only the token from the meta tag
# Google or Bing gives you, not the whole tag. Blank omits the tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Google AdSense. Leave NEXT_PUBLIC_ADSENSE_CLIENT blank and every ad slot
# renders nothing at all, the loader script is not shipped, and /ads.txt
# returns 404. Setting it publishes /ads.txt automatically, which AdSense
# requires before it will serve on the domain.
# Format: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_PROMPT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_PROMPT_PANEL=
NEXT_PUBLIC_ADSENSE_SLOT_PROMPT_MID=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_PROMPT_FOOTER=
NEXT_PUBLIC_ADSENSE_SLOT_LISTING=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_SEARCH=
